# Target: core/trade_executor.py  (close_trade, full_trade dict ~797-803)
# Opus trade-success-path audit 2026-05-29.
#
# CONFIRMED BUG (verified end-to-end):
#   close_trade computes fees_paid (trade_executor.py:728) and correctly passes
#   it to db.close_trade (line 794). But the tax event is built from a SEPARATE
#   dict, full_trade = {**trade, exit_time, exit_price, status} (797-802), which
#   spreads the ORIGINAL trade dict — that never carried fees_paid. db.record_tax_event
#   then reads fees_paid = float(trade.get("fees_paid") or 0.0) (database.py:572)
#   and computes gain_loss = proceeds - cost_basis - fees_paid. So every tax-ledger
#   row records fees_paid = 0 and an overstated gain_loss.
#
# Impact: Form 8949 / tax-year summary (export_8949_csv, get_tax_year_summary)
# overstate taxable gains by the full fee total — a real-money reporting error,
# not a paper/live divergence. Trade P&L itself is correct (pnl already nets fees);
# only the tax ledger is wrong.
#
# Fix: include fees_paid in the full_trade dict so record_tax_event sees it.
--- a/core/trade_executor.py
+++ b/core/trade_executor.py
@@ -797,6 +797,7 @@
         full_trade = {
             **trade,
             "exit_time":  datetime.now().isoformat(),
             "exit_price": current_price,
+            "fees_paid":  fees_paid,
             "status":     "closed"
         }
         self._db.record_tax_event(full_trade)
