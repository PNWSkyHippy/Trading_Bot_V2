@@ -348,6 +348,8 @@
                 elif name == "coinbase":
                     self._sync_coinbase(info)
                 elif name == "kraken":
                     self._sync_kraken(info)
+                elif name == "ibkr":
+                    self._sync_ibkr(info)
                 else:
                     logger.debug(f"No sync handler for broker: {name}")
             except Exception as e:
                 logger.debug(f"Balance sync failed for {name}: {e}")
@@ -384,6 +386,22 @@
         except Exception as e:
             logger.debug(f"Coinbase sync error: {e}")

+    def _sync_ibkr(self, info: Dict):
+        # Opus 2026-05-29: pull live IBKR equity/cash so approve_trade's
+        # per-broker cash check doesn't read the {available:0.0} default and
+        # reject live IBKR entries. Reuses the live executor singleton.
+        try:
+            from core.trade_executor import executor as _exec
+            ibkr = getattr(_exec, "_ibkr", None)
+            if ibkr is None or not ibkr.is_available():
+                return
+            acct      = ibkr.get_account()
+            equity    = float(acct.get("equity", 0))
+            available = float(acct.get("cash", 0))
+            invested  = max(0.0, equity - available)
+            self.update_broker_balance("ibkr", equity, invested, available)
+        except Exception as e:
+            logger.debug(f"IBKR sync error: {e}")
+
