# Target: bot_engine.py  (top of file, before the `from intelligence...` imports)
# Opus operational fix 2026-05-29.
#
# PROBLEM (confirmed): the `intelligence` package physically lives at
# logs\intelligence\ — there is NO intelligence\ at the repo root and NO
# __init__.py anywhere in that tree. Every launcher (run-bot profile function,
# Scripts\run_bot_window.ps1, bare `python bot_engine.py`) starts from the repo
# root WITHOUT logs\ on sys.path, so `from intelligence.ml_scorer import MLScorer`
# (line ~48) raises ModuleNotFoundError: No module named 'intelligence'.
# Setting $env:PYTHONPATH to include logs\ fixes it for one shell only — easy to
# forget and the reason it "still won't start" when launched via RUN-BOT.
#
# FIX: make bot_engine.py self-sufficient. Add logs\ to sys.path at import time,
# BEFORE the intelligence imports, so the bot starts regardless of launcher/cwd.
# os and sys are already imported just above, so this adds no new dependency.
# Verified: with logs\ on the path, `import bot_engine` -> IMPORTS_OK.
#
# NOTE: this is the minimal unblock (mirrors the PYTHONPATH workaround in code).
# The cleaner long-term option is to MOVE logs\intelligence\ -> intelligence\ at
# the repo root next to core\ / data\ and commit it — that also fixes the same
# fragile import in tools\run_backtest_matrix.py and Scripts\param_sweep.py
# (flagged in OVERHAUL_LIVE_VS_PAPER.md §"Path note"). Do that move with Sonnet
# AFTER the running param sweep finishes, then this shim can be removed.
--- a/bot_engine.py
+++ b/bot_engine.py
@@ -33,6 +33,13 @@
 import time
 from datetime import datetime, timezone

+# ── Make the `intelligence` package importable (Opus 2026-05-29) ──────────────
+# It physically lives under logs\intelligence\, which is not on sys.path when the
+# bot is launched from the repo root. Add it here, before the intelligence
+# imports below, so startup no longer depends on an external PYTHONPATH.
+_LOGS_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "logs")
+if _LOGS_DIR not in sys.path:
+    sys.path.insert(0, _LOGS_DIR)
