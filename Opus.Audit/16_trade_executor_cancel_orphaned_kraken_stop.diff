# Target: core/trade_executor.py  (close_trade, crypto branch ~705-712)
# Opus trade-success-path audit 2026-05-29.
#
# CONFIRMED BUG (not a guess — verified across three files):
#   At entry, execute_signal places a resting Kraken stop-market order
#   (kraken.place_stop_order -> type="stop-market"). On exit, close_trade's
#   crypto branch calls kraken.close_position(symbol, qty, side), which
#   (kraken_executor.py:115-123, LIVE) sends ONLY a market close order and
#   does NOT cancel that resting stop. The resting stop is cancelled in exactly
#   one place — the momentum-ride path (position_monitor.py:1451-1453). EVERY
#   other crypto exit (take_profit, time stop, stale, pivot break, SL caught by
#   the monitor) leaves the stop order LIVE on Kraken.
#
# Impact: after a normal close the orphaned stop-market can later trigger a
# phantom market order — rejected if no balance (log noise / wasted API), or on
# a margin/leveraged pair it can OPEN AN UNINTENDED SHORT. Either way the DB
# shows the position flat while the exchange still has a working order.
#
# Fix: in the LIVE crypto close, after a successful market close, cancel the
# resting stop_order_id if present. cancel_order already exists
# (kraken_executor.py:276). Paper mode is unaffected (no real orders).
--- a/core/trade_executor.py
+++ b/core/trade_executor.py
@@ -705,9 +705,24 @@
         elif asset_class == "crypto":
             # Kraken is the default crypto executor — Coinbase API is deprecated.
             side = "buy" if direction == "long" else "sell"
             if config.KRAKEN_ENABLED:
                 success = self.kraken.close_position(symbol, qty, side)
+                # ── Cancel the resting stop order (Opus 2026-05-29) ───────────
+                # close_position only sends a market close; the stop-market order
+                # placed at entry stays LIVE on Kraken. Only the momentum-ride
+                # path cancels it. Cancel here so a normal exit can't leave an
+                # orphaned stop that later fires a phantom order / unintended short.
+                if success:
+                    _stop_id = trade.get("stop_order_id", "")
+                    if _stop_id:
+                        try:
+                            self.kraken.cancel_order(symbol, _stop_id)
+                            logger.info(
+                                f"[STOP CANCEL] {symbol}: resting stop {_stop_id} "
+                                f"cancelled on close"
+                            )
+                        except Exception as _co_err:
+                            logger.warning(
+                                f"Failed to cancel resting stop {_stop_id} "
+                                f"for {symbol}: {_co_err}"
+                            )
             else:
                 logger.info(f"[PAPER] Simulated close: {symbol} {side.upper()} @ ${current_price:.4f}")
                 success = True
