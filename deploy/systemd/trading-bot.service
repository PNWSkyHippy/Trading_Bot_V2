[Unit]
Description=Trading Bot V2 engine
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/trading_bot_v2
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/trading_bot_v2/.env
ExecStart=/opt/trading_bot_v2/Scripts/linux/start_bot.sh
Restart=always
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
