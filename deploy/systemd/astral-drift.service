[Unit]
Description=Astral Drift
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/trading_bot_v2/DecentClone
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/trading_bot_v2/.env
ExecStart=/opt/trading_bot_v2/DecentClone/start_astral.sh
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

