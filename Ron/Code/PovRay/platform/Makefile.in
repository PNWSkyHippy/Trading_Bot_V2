  unix/syspovdebug.h unix/syspovtimer.cpp unix/syspovtimer.h


# Include paths for headers.
AM_CPPFLAGS = \
  -I$(top_srcdir)/unix/povconfig \
  -I$(top_srcdir)/platform/unix \
  $(cppflags_platformcpu) \
  -I$(top_srcdir)/vfe \
  -I$(top_srcdir)/vfe/unix \
  -I$(top_srcdir)/unix \
  -I$(top_srcdir)/source

all: all-am

.SUFFIXES:
.SUFFIXES: .cpp .o .obj
$(srcdir)/Makefile.in: @MAINTAINER_MODE_TRUE@ $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --gnu platform/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --gnu platform/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure: @MAINTAINER_MODE_TRUE@ $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4): @MAINTAINER_MODE_TRUE@ $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):

clean-noinstLIBRARIES:
	-test -z "$(noinst_LIBRARIES)" || rm -f $(noinst_LIBRARIES)
unix/$(am__dirstamp):
	@$(MKDIR_P) unix
	@: > unix/$(am__dirstamp)
unix/$(DEPDIR)/$(am__dirstamp):
	@$(MKDIR_P) unix/$(DEPDIR)
	@: > unix/$(DEPDIR)/$(am__dirstamp)
unix/syspovtimer.$(OBJEXT): unix/$(am__dirstamp) \
	unix/$(DEPDIR)/$(am__dirstamp)

libplatform.a: $(libplatform_a_OBJECTS) $(libplatform_a_DEPENDENCIES) $(EXTRA_libplatform_a_DEPENDENCIES) 
	$(AM_V_at)-rm -f libplatform.a
	$(AM_V_AR)$(libplatform_a_AR) libplatform.a $(libplatform_a_OBJECTS) $(libplatform_a_LIBADD)
	$(AM_V_at)$(RANLIB) libplatform.a
x86/$(am__dirstamp):
	@$(MKDIR_P) x86
	@: > x86/$(am__dirstamp)
x86/$(DEPDIR)/$(am__dirstamp):
	@$(MKDIR_P) x86/$(DEPDIR)
	@: > x86/$(DEPDIR)/$(am__dirstamp)
x86/libx86_a-cpuid.$(OBJEXT): x86/$(am__dirstamp) \
