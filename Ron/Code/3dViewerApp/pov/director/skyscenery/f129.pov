// plane1
plane {
    <0, 1, 0>, 0.5
    material {
        texture { pigment { Blood_Sky scale 500 } finish { ambient 0.1 diffuse 0.75 specular 0.2 } }
    }
}

// ---- extra POV code
// cloud layer: Stratus
plane { y, 60
    pigment { bozo turbulence 0.55 octaves 5 omega 0.5 lambda 2.2
        color_map { [0 rgbt <1, 1, 1, 1>] [0.3815 rgbt <1, 1, 1, 1>] [0.6315 rgbt <1, 1, 1, 0.25>] [1 rgbt <1, 1, 1, 0.25>] }
        scale 40 translate <7.23333, 0, 91.7> }
    finish { ambient 0 diffuse 0 }
    no_image no_reflection
}
plane { y, 60
    pigment { bozo turbulence 0.55 octaves 5 omega 0.5 lambda 2.2
        color_map { [0 rgbt <0.94902, 0.95686, 0.96863, 1>] [0.3815 rgbt <0.94902, 0.95686, 0.96863, 1>] [0.6315 rgbt <0.94902, 0.95686, 0.96863, 0.325>] [1 rgbt <0.94902, 0.95686, 0.96863, 0.325>] }
        scale 40 translate <7.23333, 0, 91.7> }
    finish { ambient 0.75 diffuse 0.35 }
    no_shadow
}
// cloud layer: High cloud
plane { y, 120
    pigment { bozo turbulence 0.55 octaves 5 omega 0.5 lambda 2.2
        color_map { [0 rgbt <1, 1, 1, 1>] [0.4485 rgbt <1, 1, 1, 1>] [0.6485 rgbt <1, 1, 1, 0.4>] [1 rgbt <1, 1, 1, 0.4>] }
        scale 70 translate <111.3, 13.7, 322.03333> }
    finish { ambient 0 diffuse 0 }
    no_image no_reflection
}
