    matrix <3.33333, 0, 0, 0, 1.33333, 0, 0, 0, 7.77778, -1.66667, 0.55556, -63.76444>
    material {
        texture { pigment { color rgb <0.83922, 0.18431, 0.18431> }
            finish { ambient 0.1 diffuse 0.75 specular 0.3 roughness 0.03 } }
        matrix <1, 0, 0, 0, 1, 0, 0, 0, 1, -1.66667, 0.55556, -63.76444>
    }
}

